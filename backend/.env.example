# ── Server ─────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ── Database ───────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/grampulse

# ── Auth ───────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# ── AI Providers ───────────────────────────────────────
# Groq: fast text generation (classification, summaries, recommendations)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini: multimodal (image analysis) + embeddings (similarity)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── Image Storage ──────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Weather (Phase 6) ──────────────────────────────────
OPENWEATHER_API_KEY=

# ── Cron (Phase 9) ─────────────────────────────────────
# Cron expression for the escalation check job. Default: once daily at 2am.
# For demo purposes you can temporarily set this to something like "*/2 * * * *" (every 2 min).
ESCALATION_CRON_SCHEDULE=0 2 * * *
ESCALATION_UNRESOLVED_DAYS_THRESHOLD=7
ESCALATION_REPORT_COUNT_THRESHOLD=10
